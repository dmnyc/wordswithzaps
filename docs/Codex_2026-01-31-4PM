      const message = err instanceof Error ? err.message : 'Failed to connect';
      setError(message);
      throw err;
    } finally {
      setConnecting(false);
    }
  }, []);

  const handleDisconnect = useCallback(() => {
    disconnect();
    setUser(null);
    setError(null);
  }, []);

  return {
    user,
    isConnected: isConnected(),
    isConnecting: connecting,
    error,
    connect,
    disconnect: handleDisconnect,

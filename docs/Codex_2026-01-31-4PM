  private async getInvoiceFromLnurl(
    callback: string,
    amountMsats: number,
    memo: string
  ): Promise<string> {
    const callbackUrl = new URL(callback);
    callbackUrl.searchParams.set('amount', amountMsats.toString());
    callbackUrl.searchParams.set('comment', memo);


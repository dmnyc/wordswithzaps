      const idx = rackCopy.indexOf(tileToUse);
      if (idx === -1) {
        return { valid: false, error: `Tile ${tileToUse} not in rack` };
      }
      rackCopy.splice(idx, 1);
    }

    // Validate board placement
    return validateMove(state.board, placements);

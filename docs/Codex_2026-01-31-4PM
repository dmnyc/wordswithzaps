  useEffect(() => {
    return () => {
      syncRef.current?.stopSubscription();
    };
  }, []);

  return {
    gameState,
    playerRack,
    isMyTurn,
    isLoading,
    error,
    lastEventId,
    createGame,
    loadGame,
    makeMove,
    pass,
    exchange,
    resign,
    deleteGame,
    validateMove: validateMoveAction,
  };
}

export default useGame;


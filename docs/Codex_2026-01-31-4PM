  const getTruncatedGameId = (gameId: string) =>
    `${gameId.slice(0, 8)}...${gameId.slice(-6)}`;

  const getProfileName = (pubkey: string, fallback: string) => {
    const profile = profiles[pubkey];
    return profile?.displayName || profile?.name || fallback;
